# ==============================================================================
# MedTrust – Environment Configuration Template
# Copy this file to .env or .env.local and update the parameters as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hyperledger Fabric Network & Gateway Configuration
# ------------------------------------------------------------------------------
FABRIC_CHANNEL=medtrustchannel
FABRIC_CHAINCODE=medtrust_cc
FABRIC_MSP_ID=HospitalOrg1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_CONNECTION_PROFILE=fabric/network/connection-org1.json
FABRIC_CERT_PATH=fabric/network/crypto-config/peerOrganizations/hospitalorg1.medtrust.health/users/Admin@hospitalorg1.medtrust.health/msp/signcerts/cert.pem
FABRIC_KEY_PATH=fabric/network/crypto-config/peerOrganizations/hospitalorg1.medtrust.health/users/Admin@hospitalorg1.medtrust.health/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=fabric/network/crypto-config/peerOrganizations/hospitalorg1.medtrust.health/peers/peer0.hospitalorg1.medtrust.health/tls/ca.crt

# ------------------------------------------------------------------------------
# 2. InterPlanetary File System (IPFS Kubo) Configuration
# ------------------------------------------------------------------------------
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 3. Medical Cryptography & Symmetric Key Encryption
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=c3918a24fb01928374a56b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e
ENCRYPTION_ALGORITHM=aes-256-gcm

# ------------------------------------------------------------------------------
# 4. Optional Gemini AI API (for patient plain summaries & terminology)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Application Server
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
